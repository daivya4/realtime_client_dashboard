generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  DEVELOPER
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  OVERDUE
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum ActivityType {
  STATUS_CHANGE
  TASK_CREATED
  TASK_ASSIGNED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role
  createdAt DateTime @default(now())
  projects Project[] @relation("ProjectOwner")
  assignedTasks Task[] @relation("TaskDeveloper")
  activities Activity[]
  notifications Notification[]
  refreshTokens RefreshToken[]
}
model Client {
  id String @id @default(cuid())
  name String
  industry String
  projects Project[]
}
model Project {
  id String @id @default(cuid())
  name String
  description String
  ownerId String
  clientId String
  createdAt DateTime @default(now())
  owner User @relation("ProjectOwner", fields: [ownerId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
  tasks Task[]
  activities Activity[]
  @@index([ownerId])
  @@index([clientId])
}
model Task {
  id Int @id @default(autoincrement())
  title String
  description String
  projectId String
  developerId String
  status TaskStatus @default(TODO)
  priority Priority @default(MEDIUM)
  dueDate DateTime
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developer User @relation("TaskDeveloper", fields: [developerId], references: [id])
  activities Activity[]
  @@index([developerId, status])
  @@index([projectId, dueDate])
  @@index([status, priority])
}
model Activity {
  id Int @id @default(autoincrement())
  type ActivityType
  message String
  fromStatus TaskStatus?
  toStatus TaskStatus?
  taskId Int?
  projectId String
  actorId String
  createdAt DateTime @default(now())
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}
model Notification {
  id Int @id @default(autoincrement())
  userId String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}
model RefreshToken {
  id Int @id @default(autoincrement())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
